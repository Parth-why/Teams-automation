# Microsoft Entra (Azure AD) App Registration Settings
# Replace with your registered Application (client) ID from Microsoft Entra / Azure Portal
AZURE_CLIENT_ID=

# Directory (tenant) ID:
# Use 'common' for multi-tenant apps, 'organizations' for work/school accounts,
# or your specific college Tenant ID GUID.
AZURE_TENANT_ID=common

# Sync & Notification Settings
SYNC_INTERVAL_MINUTES=30
REMINDER_DAYS_BEFORE_DUE=2
